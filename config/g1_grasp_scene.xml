<!--
  g1_grasp_scene.xml — MuJoCo 仿真场景
  =======================================
  用于 G1 右臂抓取任务（Phase 1.5 物理仿真）。

  场景元素：
    - G1 人形机器人（从 unitree_mujoco include）
    - 地面 + 桌面
    - 待抓取物体（杯子、方块）
    - 虚拟头部相机（RGB-D）
    - 位置执行器（覆盖 MJCF 自带的力矩电机，实现位置伺服）

  路径说明：
    - <include> 和 meshdir 使用绝对路径，需与 WSL2 用户目录一致
    - 默认用户：YOUR_USERNAME，如有不同请 sed 替换
-->
<mujoco model="g1_grasp_scene">

  <!-- ===================================================================== -->
  <!-- 编译选项                                                               -->
  <!--   不设置 meshdir — 由 MJCF 自带的 <compiler meshdir="meshes"/> 处理，  -->
  <!--   相对路径会正确解析到 MJCF 所在目录下的 meshes/ 子目录。              -->
  <!-- ===================================================================== -->
  <compiler angle="radian" autolimits="true"/>

  <!-- ===================================================================== -->
  <!-- 可视化选项                                                             -->
  <!-- ===================================================================== -->
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048"/>
  </visual>

  <!-- ===================================================================== -->
  <!-- G1 机器人模型（完整 MJCF，含 worldbody + motor 执行器 + 传感器）       -->
  <!-- ===================================================================== -->
  <include file="/home/lyrah_ubuntu24/deps/unitree_mujoco/unitree_robots/g1/g1_23dof.xml"/>

  <!-- ===================================================================== -->
  <!-- 仿真选项（在 include 之后，确保覆盖 G1 MJCF 的可能设置）               -->
  <!--   timestep=0.002: 2ms 步长（与 200 Hz bridge 匹配）                    -->
  <!-- ===================================================================== -->
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <!-- ===================================================================== -->
  <!-- 全局默认：关节自然阻尼（模拟摩擦，抑制高频振荡）                        -->
  <!--   注意：不设 geom 接触参数默认值，让 MuJoCo 使用内置默认值              -->
  <!--   （避免软接触导致 35kg 机器人足地穿透过多）                            -->
  <!-- ===================================================================== -->
  <default>
    <joint damping="2"/>
  </default>

  <!-- ===================================================================== -->
  <!-- 场景几何体（追加到 MJCF 的 worldbody 后面）                            -->
  <!-- ===================================================================== -->
  <worldbody>

    <!-- 地面（MuJoCo 默认接触参数，骨盆抬高后脚轻触地面提供稳定） -->
    <geom name="floor" type="plane" size="0 0 0.05"
          friction="1.0 0.5 0.5"
          rgba="0.8 0.8 0.8 1"/>

    <!-- ---- 光照 --------------------------------------------------------- -->
    <light name="sun" directional="true" pos="2 2 3" dir="-0.5 -0.5 -1"
           diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>

    <!-- ---- 桌面（远离机器人 5cm）---------------------------------------- -->
    <body name="table" pos="0.50 -0.15 0.75">
      <geom name="table_top" type="box" size="0.40 0.30 0.02"
            rgba="0.6 0.4 0.2 1"/>
      <geom name="leg_fl" type="cylinder" size="0.02 0.35"
            pos="-0.35 -0.25 -0.35" rgba="0.4 0.3 0.2 1"/>
      <geom name="leg_fr" type="cylinder" size="0.02 0.35"
            pos="-0.35  0.25 -0.35" rgba="0.4 0.3 0.2 1"/>
      <geom name="leg_bl" type="cylinder" size="0.02 0.35"
            pos=" 0.35 -0.25 -0.35" rgba="0.4 0.3 0.2 1"/>
      <geom name="leg_br" type="cylinder" size="0.02 0.35"
            pos=" 0.35  0.25 -0.35" rgba="0.4 0.3 0.2 1"/>
    </body>

    <!-- ---- 物体1：杯子（世界坐标，几何中心；杯底z=0.77，杯口z=0.93）----- -->
    <body name="cup" pos="0.2 0.0 0.85">
      <geom name="cup_body" type="cylinder" size="0.03 0.08"
            rgba="0.2 0.5 0.8 1" mass="0.15"/>
      <geom name="cup_bottom" type="cylinder" size="0.028 0.005"
            pos="0 0 -0.08" rgba="0.15 0.4 0.7 1" mass="0.01"/>
      <geom name="cup_handle" type="cylinder" size="0.008 0.04"
            pos="0.035 0 0.03" euler="0 0 0.8" rgba="0.2 0.5 0.8 1" mass="0.02"/>
    </body>

    <!-- ---- 物体2：方块（世界坐标，5cm立方体几何中心；底面z=0.77贴桌面）----- -->
    <body name="block" pos="0.3 -0.10 0.795">
      <geom name="block_geom" type="box" size="0.025 0.025 0.025"
            rgba="0.9 0.3 0.3 1" mass="0.05"/>
    </body>

    <!-- ---- 虚拟相机（模拟 G1 头部 RGB-D 相机）--------------------------- -->
    <camera name="head_cam"
            pos="0.02 0 0.65"
            xyaxes="1 0 0 0 0.7 0.7"
            fovy="60"
            resolution="640 480"/>

  </worldbody>

  <!-- ===================================================================== -->
  <!-- 位置执行器（覆盖 MJCF 自带的 <motor> 力矩电机）                        -->
  <!--                                                                       -->
  <!-- 增益策略：                                                             -->
  <!--   稳定关节（腿/腰/左臂）：高 kp/kv → PD 刚度对抗重力，保持静止         -->
  <!--   主动关节（右臂）：低 kp/kv → 学长经验值，外层 PID 补偿                -->
  <!-- ===================================================================== -->
  <actuator>
    <!-- ========== 右臂 5 关节（主动控制）— kp=300 高刚度 + kv=5 低阻尼 ======= -->
    <position name="act_shoulder_pitch" joint="right_shoulder_pitch_joint" kp="300" kv="5"/>
    <position name="act_shoulder_roll"  joint="right_shoulder_roll_joint"  kp="300" kv="5"/>
    <position name="act_shoulder_yaw"   joint="right_shoulder_yaw_joint"   kp="300" kv="5"/>
    <position name="act_elbow"          joint="right_elbow_joint"          kp="300" kv="5"/>
    <position name="act_wrist_roll"     joint="right_wrist_roll_joint"     kp="300" kv="5"/>

    <!-- ========== 左臂 5 关节（保持姿态）========== -->
    <position name="act_left_shoulder_pitch" joint="left_shoulder_pitch_joint" kp="100" kv="5"/>
    <position name="act_left_shoulder_roll"  joint="left_shoulder_roll_joint"  kp="100" kv="5"/>
    <position name="act_left_shoulder_yaw"   joint="left_shoulder_yaw_joint"   kp="100" kv="5"/>
    <position name="act_left_elbow"          joint="left_elbow_joint"          kp="100" kv="5"/>
    <position name="act_left_wrist_roll"     joint="left_wrist_roll_joint"     kp="100" kv="5"/>

    <!-- ========== 左腿 6 关节 — kp=600 高刚度抗重力 ========== -->
    <position name="act_left_hip_pitch"   joint="left_hip_pitch_joint"   kp="600" kv="50"/>
    <position name="act_left_hip_roll"    joint="left_hip_roll_joint"    kp="600" kv="50"/>
    <position name="act_left_hip_yaw"     joint="left_hip_yaw_joint"     kp="600" kv="50"/>
    <position name="act_left_knee"        joint="left_knee_joint"        kp="600" kv="50"/>
    <position name="act_left_ankle_pitch" joint="left_ankle_pitch_joint" kp="600" kv="50"/>
    <position name="act_left_ankle_roll"  joint="left_ankle_roll_joint"  kp="600" kv="50"/>

    <!-- ========== 右腿 6 关节 — kp=600 高刚度抗重力 ========== -->
    <position name="act_right_hip_pitch"   joint="right_hip_pitch_joint"   kp="600" kv="50"/>
    <position name="act_right_hip_roll"    joint="right_hip_roll_joint"    kp="600" kv="50"/>
    <position name="act_right_hip_yaw"     joint="right_hip_yaw_joint"     kp="600" kv="50"/>
    <position name="act_right_knee"        joint="right_knee_joint"        kp="600" kv="50"/>
    <position name="act_right_ankle_pitch" joint="right_ankle_pitch_joint" kp="600" kv="50"/>
    <position name="act_right_ankle_roll"  joint="right_ankle_roll_joint"  kp="600" kv="50"/>

    <!-- ========== 腰部 3 关节 — 维持躯干直立 ========== -->
    <position name="act_waist_yaw"   joint="waist_yaw_joint"   kp="300" kv="20"/>
    <position name="act_waist_roll"  joint="waist_roll_joint"  kp="300" kv="20"/>
    <position name="act_waist_pitch" joint="waist_pitch_joint" kp="300" kv="20"/>

    <!-- ========== 腕部 dummy 关节 ========== -->
    <position name="act_left_wrist_pitch" joint="left_wrist_pitch_joint" kp="30" kv="2"/>
    <position name="act_left_wrist_yaw"   joint="left_wrist_yaw_joint"   kp="30" kv="2"/>
    <position name="act_right_wrist_pitch" joint="right_wrist_pitch_joint" kp="30" kv="2"/>
    <position name="act_right_wrist_yaw"   joint="right_wrist_yaw_joint"   kp="30" kv="2"/>
  </actuator>

  <!--
  ============================================================================
  传感器 — MJCF include 已自带所有关节 pos/vel/torque 传感器，此处不重复定义
  ============================================================================
  -->

</mujoco>
