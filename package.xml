<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_right_arm_reach</name>
  <version>0.1.0</version>
  <description>
    G1 humanoid robot right arm reaching controller.
    Pure PID control with damped pseudoinverse IK, variable gain,
    integral anti-windup, and null-space joint-limit avoidance.
  </description>
  <maintainer email="user@example.com">G1 Developer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pinocchio</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>action_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
